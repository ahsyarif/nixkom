---
import Icon from '../components/Icon.astro';
import { SITE, MENU, getPosts, terms, postUrl } from '../lib/site';
import type { MarkdownHeading } from 'astro';

interface Props {
  title?: string; // omitted on home
  description?: string;
  crumbs?: { name: string; href: string }[]; // between Beranda and the current page
  headings?: MarkdownHeading[];
  article?: { published: Date; tags: string[]; categories: string[] };
  noindex?: boolean;
}
const { title, description = SITE.description, crumbs = [], headings = [], article, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/' || /^\/\d+\/$/.test(path);
const site = Astro.site!;
const canonical = new URL(path, site).href;
const fullTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const pageTitle = title && [...fullTitle].length > 60 ? title : fullTitle;
const pageName = title ?? SITE.title;
const ctx = 'https://schema.org';
const ld: Record<string, unknown>[] = [];
if (path === '/') ld.push({ '@context': ctx, '@type': 'WebSite', name: SITE.title, url: site.href, inLanguage: 'id', description });
if (article)
  ld.push({
    '@context': ctx,
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: article.published.toISOString(),
    dateModified: article.published.toISOString(),
    inLanguage: 'id',
    author: { '@type': 'Person', name: SITE.author, url: new URL('/about/', site).href },
    url: canonical,
    mainEntityOfPage: canonical,
    keywords: article.tags.join(', '),
    articleSection: article.categories[0],
  });
if (path !== '/' && !noindex) {
  const items = [
    { name: 'Beranda', item: site.href },
    ...crumbs.map((c) => ({ name: c.name, item: new URL(c.href, site).href })),
    { name: pageName, item: canonical },
  ];
  ld.push({
    '@context': ctx,
    '@type': 'BreadcrumbList',
    itemListElement: items.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
  });
}
const posts = await getPosts();
const recent = posts.slice(0, 5);
const topTags = terms(posts, 'tags').sort((a, b) => b.posts.length - a.posts.length).slice(0, 10);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const tocTree: (MarkdownHeading & { kids: MarkdownHeading[] })[] = [];
for (const h of toc) {
  if (h.depth === 3 && tocTree.length) tocTree.at(-1)!.kids.push(h);
  else tocTree.push({ ...h, kids: [] });
}
---
<!DOCTYPE html>
<html lang="id" data-mode="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/index.xml">
  <meta property="og:site_name" content={SITE.title}>
  <meta property="og:title" content={pageName}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content={article ? 'article' : 'website'}>
  <meta property="og:locale" content="id_ID">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={pageName}>
  <meta name="twitter:description" content={description}>
  {article && <meta property="article:published_time" content={article.published.toISOString()}>}
  {article?.categories.map((c) => <meta property="article:section" content={c}>)}
  {article?.tags.map((t) => <meta property="article:tag" content={t}>)}
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-mode', saved);
    })();
  </script>
</head>
<body>
  <aside aria-label="Sidebar" id="sidebar">
    <header class="profile-wrapper">
      <a href="/" id="avatar" aria-label={`${SITE.title} beranda`}>
        <svg viewBox="0 0 112 112" width="112" height="112" aria-hidden="true">
          <rect width="112" height="112" fill="var(--avatar-bg, #23262e)"/>
          <path d="M32 42L48 56L32 70" stroke="var(--link-color)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <line x1="54" y1="70" x2="80" y2="70" stroke="var(--heading-color)" stroke-width="6" stroke-linecap="round"/>
        </svg>
      </a>
      <a class="site-title" href="/">{SITE.title}</a>
      <p class="site-subtitle">{SITE.tagline}</p>
    </header>

    <nav aria-label="Primary">
      <ul class="nav">
        {MENU.map((m) => (
          <li class:list={['nav-item', { active: path === m.url || (m.url !== '/' && path.startsWith(m.url)) }]}>
            <a href={m.url} class="nav-link">
              <span class="nav-icon" aria-hidden="true"><Icon name={m.id} /></span>
              <span>{m.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="sidebar-bottom">
      <button type="button" class="mode-toggle" id="theme-toggle" aria-label="Ganti mode terang/gelap" title="Ganti mode terang/gelap">
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <span class="icon-border"></span>
      <a href={SITE.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer" title="GitHub">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11.05 11.05 0 0 1 5.78 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.24 2.75.12 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
      </a>
      <a href="/index.xml" aria-label="RSS" title="Feed RSS">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>
      </a>
    </div>
  </aside>
  <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>

  <div id="main-wrapper">
    <header id="topbar-wrapper" aria-label="Bilah atas">
      <div id="topbar">
        <div class="topbar-left">
          <button type="button" id="sidebar-trigger" aria-label="Buka menu" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <nav id="breadcrumb" aria-label="Lokasi halaman">
            {isHome ? <span>Beranda</span> : (
              <>
                <span><a href="/">Beranda</a></span>
                {crumbs.map((c) => <span><a href={c.href}>{c.name}</a></span>)}
                <span>{title}</span>
              </>
            )}
          </nav>
          <div id="topbar-title">{isHome ? SITE.title : title}</div>
        </div>

        <div class="search-wrapper">
          <search id="search">
            <svg class="search-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="search" id="search-input" placeholder="Cari..." aria-label="Cari artikel" autocomplete="off">
          </search>
          <div id="search-results" class="search-results" hidden></div>
        </div>
      </div>
    </header>

    <div class="main-container">
      <main aria-label="Konten utama" class="main-content">
        <slot />
      </main>

      <aside aria-label="Panel samping" id="panel-wrapper">
        <div class="access">
          {recent.length > 0 && (
            <section id="access-lastmod" class="panel-section">
              <h2 class="panel-heading">Artikel terbaru</h2>
              <ul class="plain-list">
                {recent.map((p) => <li class="text-truncate"><a href={postUrl(p)}>{p.data.title}</a></li>)}
              </ul>
            </section>
          )}
          {topTags.length > 0 && (
            <section class="panel-section">
              <h2 class="panel-heading">Tag populer</h2>
              <div class="tag-cloud">
                {topTags.map((t) => <a class="post-tag" href={`/tags/${t.slug}/`}>{t.name}</a>)}
              </div>
            </section>
          )}
        </div>

        {toc.length > 0 && (
          <section id="toc-wrapper" class="panel-section toc-panel">
            <h2 class="panel-heading">Daftar isi</h2>
            <nav id="toc">
              <div id="TableOfContents">
                <ul>
                  {tocTree.map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                      {h.kids.length > 0 && (
                        <ul>{h.kids.map((k) => <li><a href={`#${k.slug}`}>{k.text}</a></li>)}</ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </nav>
          </section>
        )}
      </aside>
    </div>

    <footer aria-label="Info situs" class="site-footer">
      <p>© <time>{new Date().getFullYear()}</time> <a href="/about/">{SITE.author}</a>. <span class="muted">Sebagian hak dilindungi.</span></p>
      <p class="muted">Dibangun dengan <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>, bergaya <a href="https://github.com/cotes2020/jekyll-theme-chirpy" target="_blank" rel="noopener">Chirpy</a></p>
    </footer>
  </div>

  <button id="back-to-top" type="button" aria-label="Kembali ke atas" title="Kembali ke atas" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
  </button>

  <script src="../scripts/client.ts"></script>
</body>
</html>
