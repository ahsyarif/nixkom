---
import Base from '../../layouts/Base.astro';
import { getPosts, terms } from '../../lib/site';

const tags = terms(await getPosts(), 'tags');
---
<Base title="Tag" description={`Telusuri ${tags.length} tag artikel di nixkom.id, seperti ${[...tags].sort((a, b) => b.posts.length - a.posts.length).slice(0, 5).map((t) => t.name).join(', ')}.`}>
  <h1 class="dynamic-title">Tag</h1>
  <div id="tags">
    {tags.length === 0 && <p class="muted">Belum ada tag.</p>}
    {tags.map((t) => <a class="tag" href={`/tags/${t.slug}/`}>{t.name}<span class="muted">{t.posts.length}</span></a>)}
  </div>
</Base>
