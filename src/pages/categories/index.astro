---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, terms, postUrl, fmtDate, isoDate } from '../../lib/site';

const cats = terms(await getPosts(), 'categories');
---
<Base title="Kategori" description={`Semua kategori di nixkom.id: ${cats.map((c) => c.name).join(', ')}.`}>
  <h1 class="dynamic-title">Kategori</h1>
  <div class="category-list">
    {cats.length === 0 && <p class="muted">Belum ada kategori.</p>}
    {cats.map((c) => (
      <div class="category-card">
        <div class="category-card-header">
          <span>
            <Icon name="folder" />
            <a href={`/categories/${c.slug}/`}>{c.name}</a>
            <span class="muted small-text">{c.posts.length} artikel</span>
          </span>
          <a href={`/categories/${c.slug}/`} class="category-trigger" aria-label={`Lihat kategori ${c.name}`}><Icon name="chevron" size={15} /></a>
        </div>
        <ul class="category-posts plain-list">
          {c.posts.slice(0, 5).map((p) => (
            <li>
              <a href={postUrl(p)}>{p.data.title}</a>
              <time class="muted small-text" datetime={isoDate(p.data.date)}>{fmtDate(p.data.date)}</time>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Base>
